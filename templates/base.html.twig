<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#174f35">
        <meta name="description" content="Natürlich baden ohne Chlor im chemie- und barrierefreien Waldbad Borkheide.">
        {% set site_logo = constant('App\\Logic\\Common\\SiteLogo::DEFAULT_URL') %}
        <link rel="icon" href="{{ site_logo }}" type="image/png">
        <link rel="apple-touch-icon" href="{{ site_logo }}">
        <title>{% block title %}Waldbad Borkheide{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
    </body>
</html>
