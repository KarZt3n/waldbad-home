<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#174f35">
        <link rel="icon" href="/downloads/waldbad-borkheide-logo.svg" type="image/svg+xml">
        <link rel="icon" href="/downloads/waldbad-borkheide-logo.png" type="image/png">
        <link rel="apple-touch-icon" href="/downloads/waldbad-borkheide-logo.png">
        <title>{% block title %}Waldbad Borkheide{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
    </body>
</html>
