{% extends 'base.html.twig' %}

{# Gleiches Format wie `updateDocumentMetadata` in `assets/public.js` beim Seitenwechsel. #}
{% block title %}{{ metaTitle }} – Waldbad Borkheide{% endblock %}
{% block meta %}
    {% set description = metaDescription ?? 'Natürlich baden ohne Chlor im chemie- und barrierefreien Waldbad Borkheide.' %}
    <meta name="description" content="{{ description }}">
    {% if indexable %}
        <link rel="canonical" href="{{ canonicalUrl }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Waldbad Borkheide">
        <meta property="og:locale" content="de_DE">
        <meta property="og:title" content="{{ metaTitle }}">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:url" content="{{ canonicalUrl }}">
    {% else %}
        <meta name="robots" content="noindex">
    {% endif %}
{% endblock %}
{% block body_class %}public-site{% endblock %}
{% block importmap %}{{ importmap('public') }}{% endblock %}

{% block body %}
    <div id="app" data-app="public" data-page-slug="{{ slug }}" data-logo-url="{{ logoUrl }}">
        <p class="app-loading" role="status">Inhalte werden geladen …</p>
    </div>
    <script type="application/json" id="site-chrome-data">{{ siteChrome|raw }}</script>
{% endblock %}
