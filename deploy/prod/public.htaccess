# Wird bei jedem Prod-Deployment nach public_html/.htaccess kopiert (deploy/prod-deploy-remote.sh).
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Unter PHP als CGI kommt der Authorization-Header sonst nicht bei Symfony an.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource /index.php
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Text-Antworten komprimiert ausliefern (HTML, API-JSON, CSS, JavaScript, robots.txt, Sitemap).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Dateien unter /assets tragen einen Inhalts-Hash im Namen (AssetMapper) und ändern sich nie —
# eine neue Version bekommt einen neuen Namen. Deshalb dürfen Browser sie ein Jahr behalten.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
