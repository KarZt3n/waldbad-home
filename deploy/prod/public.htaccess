# Wird bei jedem Prod-Deployment nach public_html/.htaccess kopiert (deploy/prod-deploy-remote.sh).
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Unter PHP als CGI kommt der Authorization-Header sonst nicht bei Symfony an.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Vorkomprimierte Assets (siehe `precompress` in config/packages/asset_mapper.yaml): Das Hosting
    # bietet kein mod_deflate, deshalb liegen .br/.gz-Fassungen fertig neben den Dateien.
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(assets/.+\.(?:css|js))$ $1.br [L]
    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME}.gz -f
    RewriteRule ^(assets/.+\.(?:css|js))$ $1.gz [L]
    RewriteRule \.css\.(?:br|gz)$ - [T=text/css,E=no-gzip:1,E=no-brotli:1]
    RewriteRule \.js\.(?:br|gz)$ - [T=text/javascript,E=no-gzip:1,E=no-brotli:1]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    FallbackResource /index.php
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js)\.br$">
        Header set Content-Encoding br
    </FilesMatch>
    <FilesMatch "\.(?:css|js)\.gz$">
        Header set Content-Encoding gzip
    </FilesMatch>
</IfModule>
# Sonst würde Apache .gz/.br als eigenen Dateityp bzw. doppelt kodiert ausliefern.
<IfModule mod_mime.c>
    RemoveType .gz .br
    RemoveEncoding .gz .br
</IfModule>

# Text-Antworten komprimiert ausliefern, falls mod_deflate verfügbar ist (auf dem Prod-Hosting nicht,
# dort greifen für CSS/JS die vorkomprimierten Dateien oben).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Dateien unter /assets tragen einen Inhalts-Hash im Namen (AssetMapper) und ändern sich nie —
# eine neue Version bekommt einen neuen Namen. Deshalb dürfen Browser sie ein Jahr behalten.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
        # Je nach Browser kommt dieselbe Adresse als Brotli, gzip oder unkomprimiert.
        Header merge Vary Accept-Encoding
    </If>
</IfModule>
